# ---------------------------------------------------------------
# ShopGenius AI — variables de entorno.
# Copiar este archivo a .env es OPCIONAL: `npm run dev` (o `npm run setup:env`)
# crea .env con DATABASE_URL, APP_MODE, BILLING_TEST_MODE y APP_ENCRYPTION_KEY
# (modo prueba) si faltan, sin pisar lo que ya tengas.
# `shopify app dev` inyecta SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL y SCOPES automáticamente.
# ---------------------------------------------------------------

# Credenciales de la app (Shopify Partners)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,write_files

# Versión de la Admin API (por defecto 2026-10)
SHOPIFY_API_VERSION=2026-10

# Base de datos (SQLite en modo prueba)
DATABASE_URL=file:dev.sqlite

# Clave para cifrar las API keys de IA de cada tienda.
# Genera una con: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# IA por defecto: demo | openai | anthropic | openrouter | qwen
# En modo demo no se consumen créditos ni hace falta ninguna API key.
AI_PROVIDER=demo
# Claves opcionales de la plataforma (cada tienda puede usar la suya en Ajustes)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# QWEN_API_KEY=
# Modelo y endpoint por defecto opcionales (compatibles con OpenAI)
# AI_MODEL=
# AI_BASE_URL=

# ---------------- MODO PRUEBA / MODO REAL ----------------
# El proyecto se entrega SIEMPRE en modo prueba: los cobros son cargos de
# prueba de Shopify (no se factura nada).
# Pasar a modo real se decidirá cuando se vaya a vender. Para hacerlo hay que
# cambiar los DOS valores a la vez: APP_MODE=live y BILLING_TEST_MODE=false.
APP_MODE=test
BILLING_TEST_MODE=true
# Días de prueba gratuita de la suscripción (0 = sin prueba, máximo 30)
BILLING_TRIAL_DAYS=0
